{
  "expo": {
    "name": "hitpan",
    "slug": "hitpan-app",
    "scheme": "hitpan",
    "owner": "aaangeliquesso",
    "icon": "./logo/icon.png",
    "android": {
      "package": "com.aaangeliquesso.hitpan",
      "icon": "./logo/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./logo/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HitPan uses your camera to take product photos.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./logo/burgundy-secondary-logo.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06d6b42c-40ba-44d7-9da1-6f10d7529c37"
      }
    }
  }
}
